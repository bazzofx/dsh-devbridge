{
  "manifest_version": 3,
  "name": "Dev Bridge for DSH",
  "version": "1.1.5",
  "description": "Click any element on a web page, write a review, and send its exact selector + XPath straight into your DSH chat.",
  "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Dev Bridge for DSH — element reviews for your Harness chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "arm-picker": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Pick an element on this page and send your review to the DSH chat"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3080/*", "http://localhost:3080/*"],
      "js": ["content/capture-format.js", "content/send.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
